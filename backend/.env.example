# =============================================================================
# ExposureIQ Backend — Variables de Entorno
# =============================================================================

# Configuración de Servidor
HOST=0.0.0.0
PORT=8080
RUST_LOG=info,exposureiq_backend=debug

# Base de datos PostgreSQL dedicada para ExposureIQ
DATABASE_URL=postgres://postgres:postgres@localhost:5432/exposureiq_db?sslmode=disable
DATABASE_MAX_CONNECTIONS=10

# Seguridad y Autenticación JWT
JWT_SECRET=super_secret_jwt_key_change_in_production_2026_exposureiq
JWT_EXPIRATION_HOURS=24

# Directorio de subida de archivos (PDFs de Coparmex)
UPLOAD_DIR=./uploads

# Integración con Workers Python (Surya OCR y Síntesis Claude)
WORKER_BASE_URL=http://127.0.0.1:8001

# Integración con WAHA (WhatsApp HTTP API)
WAHA_BASE_URL=http://127.0.0.1:3000
WAHA_SESSION=default
WAHA_API_KEY=

# Destinatario predeterminado para el Director de Operaciones (mono-cliente)
DIRECTOR_WHATSAPP_PHONE=5215512345678
