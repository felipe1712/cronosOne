# =============================================================================
# ExposureIQ Python Workers — Variables de Entorno
# =============================================================================

PORT=8001
HOST=0.0.0.0

# Base de datos PostgreSQL de ExposureIQ
DATABASE_URL=postgres://postgres:postgres@localhost:5432/exposureiq_db

# API Key de Anthropic Claude para síntesis ejecutiva
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# Servicio interno Surya OCR (compartido en el mismo servidor)
SURYA_OCR_URL=http://localhost:5000/ocr

# Teléfono del Director de Operaciones para entrega WhatsApp
DIRECTOR_WHATSAPP_PHONE=

# world-intel-mcp endpoint / command
WORLD_INTEL_MCP_URL=http://localhost:8088

# =============================================================================
# Configuración de Proxy Residencial (Recomendado: Geonode con salida México)
# =============================================================================
# Opción 1: URL completa con credenciales (Geonode residential proxy con filtro country-mx)
# SCRAPER_PROXY_URL=http://geonode_user-country-mx:password@premium-residential.geonode.com:9000
SCRAPER_PROXY_URL=

# Opción 2: Parámetros individuales si prefieres separarlos
SCRAPER_PROXY_HOST=
SCRAPER_PROXY_PORT=9000
SCRAPER_PROXY_USERNAME=
SCRAPER_PROXY_PASSWORD=
